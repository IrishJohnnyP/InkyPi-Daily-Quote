export default {
  async fetch(request, env) {
    const corsHeaders = {
      "Access-Control-Allow-Origin": "*",
      "Access-Control-Allow-Methods": "GET, HEAD, OPTIONS",
      "Access-Control-Allow-Headers": "Content-Type, X-App-Key",
    };

    // 1️⃣ Handle CORS Preflight Requests
    if (request.method === "OPTIONS") {
      return new Response(null, { headers: corsHeaders });
    }

    // --- SECURITY CHECK ---
    const clientKey = request.headers.get('X-App-Key');
    if (!clientKey || clientKey !== env.app_key) {
      return new Response(JSON.stringify({ error: "Unauthorized" }), { 
        status: 401, 
        headers: { ...corsHeaders, "Content-Type": "application/json" }
      });
    }
    // ----------------------

    try {
      const url = new URL(request.url);
      const testProvider = url.searchParams.get("provider");
      const forcedProvider = testProvider || env.FORCE_PROVIDER || null;

      const providerWeights = {
        zenquotes: 3,
        ninjas: 4,
        favqs: 1,
        motivational: 2,
      };

      // Determine the primary provider
      const primaryProvider = forcedProvider && providerWeights[forcedProvider]
        ? forcedProvider
        : selectWeightedProvider(providerWeights);

      // Build a resilient fallback queue (Primary first, remaining shuffled)
      let providersQueue = Object.keys(providerWeights).filter(p => p !== primaryProvider);
      providersQueue = providersQueue.sort(() => Math.random() - 0.5);
      providersQueue.unshift(primaryProvider);

      let quoteData = null;
      let successfulProvider = null;

      // 2️⃣ Try providers in sequence until one succeeds
      for (const provider of providersQueue) {
        try {
          quoteData = await fetchFromProvider(provider, env);
          if (quoteData && quoteData.text) {
            successfulProvider = provider;
            break; // Success! Exit the fallback loop.
          }
        } catch (err) {
          console.warn(`Provider ${provider} failed:`, err.message);
          continue; // Move to the next backup provider
        }
      }

      // 3️⃣ Final Fallback if ALL upstream APIs fail
      if (!quoteData || !quoteData.text) {
        quoteData = {
          text: "Failure is simply the opportunity to begin again.",
          author: "Henry Ford",
          source: "Fallback",
        };
        successfulProvider = "fallback";
      }

      // ✅ FIX TEXT ENCODING (Native Decoding Trick)
      quoteData.text = fixTextEncoding(quoteData.text);
      quoteData.author = fixTextEncoding(quoteData.author);

      return new Response(
        JSON.stringify({
          ...quoteData,
          provider: successfulProvider,
          weighted: !forcedProvider && successfulProvider !== "fallback",
        }),
        {
          status: 200,
          headers: {
            ...corsHeaders,
            "Content-Type": "application/json; charset=utf-8",
            "Cache-Control": "no-store",
          },
        }
      );
    } catch (err) {
      // Catastrophic worker failure fallback
      return new Response(
        JSON.stringify({
          text: "Failure is simply the opportunity to begin again.",
          author: "Henry Ford",
          source: "Worker Error",
          provider: "error",
        }),
        {
          status: 500,
          headers: {
            "Access-Control-Allow-Origin": "*",
            "Content-Type": "application/json; charset=utf-8",
          },
        }
      );
    }
  },
};

// --- Helper Functions ---

// Extracted fetch logic to keep the main block clean and allow looping
async function fetchFromProvider(provider, env) {
  if (provider === "zenquotes") {
    const resp = await fetch("https://zenquotes.io/api/random");
    if (!resp.ok) throw new Error(`ZenQuotes failed: ${resp.status}`);
    const data = await resp.json();
    return { text: data[0].q, author: data[0].a, source: "ZenQuotes" };
  }

  if (provider === "ninjas") {
    const resp = await fetch("https://api.api-ninjas.com/v2/randomquotes", {
      headers: { "X-Api-Key": env.NINJAS_API_KEY },
    });
    if (!resp.ok) throw new Error(`API Ninjas failed: ${resp.status}`);
    const data = await resp.json();
    return { text: data[0].quote, author: data[0].author || "Unknown", source: "API Ninjas" };
  }

  if (provider === "favqs") {
    const page = Math.floor(Math.random() * 5) + 1;
    const resp = await fetch(`https://favqs.com/api/quotes?page=${page}`, {
      headers: { Authorization: `Token token=${env.FAVQS_API_KEY}` },
    });
    if (!resp.ok) throw new Error(`FavQs failed: ${resp.status}`);
    const data = await resp.json();
    const quote = data.quotes[Math.floor(Math.random() * data.quotes.length)];
    if (!quote || !quote.body) throw new Error("Empty quote body from FavQs");
    return { text: quote.body, author: quote.author || "Unknown", source: "FavQs" };
  }

  if (provider === "motivational") {
    const resp = await fetch("https://motivational-spark-api.vercel.app/api/quotes/random");
    if (!resp.ok) throw new Error(`Motivational Spark failed: ${resp.status}`);
    const data = await resp.json();
    return { text: data.quote, author: data.author || "Unknown", source: "Motivational Spark" };
  }

  throw new Error("Unknown provider");
}

// Weighted selector
function selectWeightedProvider(weights) {
  const entries = Object.entries(weights);
  const total = entries.reduce((sum, [, w]) => sum + w, 0);
  let roll = Math.random() * total;

  for (const [provider, weight] of entries) {
    if (roll < weight) return provider;
    roll -= weight;
  }
}

// Native byte-level decoder
function fixTextEncoding(text) {
  if (!text) return text;
  try {
    if (text.includes("â€") || text.includes("â\u0080")) {
      const bytes = Uint8Array.from(text, (c) => c.charCodeAt(0));
      return new TextDecoder("utf-8").decode(bytes);
    }
    return text;
  } catch (e) {
    return text;
  }
}
